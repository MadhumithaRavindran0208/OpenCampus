# Exclude everything not needed in the Docker image
.git
.gitignore
.env
.env.*
!.env.example

# Local dev artifacts
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.db
*.db-wal
*.db-shm
instance/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
tests/

# Documentation (not needed at runtime)
*.md
docs/

# Editor config
.vscode/
.idea/

# CI config (not needed in image)
.github/
