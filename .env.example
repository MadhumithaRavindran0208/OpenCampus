# ============================================================
# OpenCampus OSS — environment variable reference
# ============================================================
# Copy this file to .env and fill in the values appropriate for
# your environment.  Nothing here is required to run locally —
# every value has a safe default in app/core/config.py.

# ── Identity / security ──────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
OPENCAMPUS_SECRET_KEY=change-me-to-a-long-random-string

# Required to sign in as a platform_admin (the secret code is asked for on the login form).
# There is deliberately no default: leave unset and admin login is disabled.
MAIN_ADMIN_SECRET_CODE=change-me-admin-code

# Set to true once served over HTTPS (marks session/remember cookies Secure).
OPENCAMPUS_COOKIE_SECURE=false

# How long a signed-in session stays valid (days).
OPENCAMPUS_SESSION_DAYS=14

# ── Storage ──────────────────────────────────────────────────
# Where the SQLite database file and crash reports are stored.
OPENCAMPUS_DATA_DIR=./instance
OPENCAMPUS_DB_FILENAME=opencampus.db

# ── Server ───────────────────────────────────────────────────
PORT=5000
OPENCAMPUS_ENV=development    # set to "production" to use Gunicorn / waitress
FLASK_DEBUG=true              # ignored when OPENCAMPUS_ENV=production

# ── Tier 1: Real-Time (SSE + Redis) ─────────────────────────
# Redis connection URL.  Used by:
#   • Flask-Limiter (shared rate-limit counters across Gunicorn workers)
#   • Optional SSE Pub/Sub backend (uncomment in app/core/sse.py)
# Omit or leave blank to fall back to in-process memory (single-worker only).
REDIS_URL=redis://localhost:6379/0

# ── Tier 1: Gunicorn ────────────────────────────────────────
# Number of Gunicorn worker processes.  Default: 2×CPU+1 (capped at 9).
# WEB_CONCURRENCY=4
# Worker threads per process.
# GUNICORN_THREADS=4
# Worker timeout in seconds (must be > SSE heartbeat interval of 25s).
# GUNICORN_TIMEOUT=30
# Log level: debug | info | warning | error | critical
# GUNICORN_LOGLEVEL=info

# ── Tier 2: Rate limiting ────────────────────────────────────
# Flask-Limiter uses REDIS_URL (above) for shared counters.
# Default global limits (app/__init__.py): 200/min, 20/sec.
# Route-specific limits: login=10/min, register=5/min, search=30/min.
# Customise in app/core/rate_limit.py or per-route @limiter.limit() decorators.

# ── Feature flags ────────────────────────────────────────────
OPENCAMPUS_ALLOW_SIGNUP=true
OPENCAMPUS_CLUB_APPROVAL=false

# ── External email dispatch (optional) ──────────────────────
OPENCAMPUS_ENABLE_EMAIL=false
OPENCAMPUS_SMTP_HOST=
OPENCAMPUS_SMTP_PORT=587
OPENCAMPUS_SMTP_USERNAME=
OPENCAMPUS_SMTP_PASSWORD=
OPENCAMPUS_EMAIL_FROM=noreply@opencampus.local

# ── External webhook dispatch (optional) ─────────────────────
OPENCAMPUS_ENABLE_WEBHOOK=false
OPENCAMPUS_WEBHOOK_URL=

# ── Logging ──────────────────────────────────────────────────
# Override the root log level: DEBUG | INFO | WARNING | ERROR
# OPENCAMPUS_LOG_LEVEL=INFO

# ── Docker Compose (production overrides) ────────────────────
# Postgres (if/when you migrate from SQLite):
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://opencampus:change-me@postgres:5432/opencampus
