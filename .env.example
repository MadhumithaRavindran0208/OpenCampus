# Copy this file to .env and adjust as needed (or just export these as
# real environment variables). Nothing here is required to run the app --
# every value has a safe default in app/core/config.py.

# Change this in any real deployment -- it signs session cookies.
OPENCAMPUS_SECRET_KEY=change-me-to-a-long-random-string

# How long a signed-in session stays valid.
OPENCAMPUS_SESSION_DAYS=14

# Where the SQLite file and any other instance data live.
OPENCAMPUS_DATA_DIR=./instance
OPENCAMPUS_DB_FILENAME=opencampus.db

# Feature flags
OPENCAMPUS_ALLOW_SIGNUP=true
OPENCAMPUS_CLUB_APPROVAL=false

# Server
PORT=5000
FLASK_DEBUG=true
